<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · 2K27 Player Randomizer</title>
<link rel="icon" href="/images/ball.svg" type="image/svg+xml">
<% if (typeof meta === 'object' && meta) { %>
<meta name="description" content="<%= meta.description %>">
<meta property="og:type" content="profile">
<meta property="og:site_name" content="2K27 Player Randomizer">
<meta property="og:title" content="<%= meta.title %>">
<meta property="og:description" content="<%= meta.description %>">
<meta property="og:url" content="<%= meta.url %>">
<meta name="twitter:card" content="summary">
<% } %>
<link rel="stylesheet" href="/css/style.css">
<script src="/js/fx.js" defer></script>
</head>
<body<%- typeof bodyAttrs === 'string' ? ' ' + bodyAttrs : '' %>>
<header class="topbar">
  <a class="brand" href="/">
    <img src="/images/bbp.png" alt="" width="48" height="32">
    <span><strong>2K27</strong> Player Randomizer</span>
  </a>
  <nav>
    <button type="button" id="sfx-toggle" class="sfx-toggle" aria-label="Sound effects" aria-pressed="true" hidden>
      <svg class="sfx-on" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4 9h4l5-4v14l-5-4H4zM16 8.5a5 5 0 0 1 0 7l-1.4-1.4a3 3 0 0 0 0-4.2zM18.5 6a8.5 8.5 0 0 1 0 12l-1.4-1.4a6.5 6.5 0 0 0 0-9.2z"/></svg>
      <svg class="sfx-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4 9h4l5-4v14l-5-4H4zM16.3 9.7l1.4-1.4 2.3 2.3 2.3-2.3 1.4 1.4-2.3 2.3 2.3 2.3-1.4 1.4-2.3-2.3-2.3 2.3-1.4-1.4 2.3-2.3z"/></svg>
    </button>
    <% if (user) { %>
      <a href="/players">My Players</a>
      <a href="/players/new" class="btn btn-sm">+ New Player</a>
      <form action="/logout" method="post" class="inline">
        <button type="submit" class="link">Log out <span class="muted">(<%= user.username %>)</span></button>
      </form>
    <% } else { %>
      <% if (guestCount) { %><a href="/players">My Players <span class="muted">(<%= guestCount %> unsaved)</span></a><% } %>
      <a href="/players/new">Create Player</a>
      <a href="/login">Log In</a>
      <a href="/register" class="btn btn-sm">Sign Up</a>
    <% } %>
  </nav>
</header>
<main>
<% for (const f of flash) { %>
  <div class="flash flash-<%= f.type %>"><%= f.text %></div>
<% } %>
